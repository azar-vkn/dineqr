rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // DineQR Firestore Security Rules — Production Hardened v2
    // ===============================================================
    //
    // Collection: menu        — Public read, admin write
    // Collection: orders      — Public create (validated), staff manage
    // Collection: users       — RBAC for admin/staff
    // Collection: feedback    — Public create (validated), staff read
    // Collection: reports     — Staff only
    //
    // CATCH-ALL: Deny everything not explicitly allowed
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() && request.auth.token.email == "asirselvin446@gmail.com";
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "asirselvin446@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin')
      );
    }

    function isStaff() {
      return isAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'staff'
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 320 &&
             data.role in ['admin', 'staff'] &&
             data.createdAt is timestamp;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'available']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0 && data.price <= 100000 &&
             data.category in ['Starters', 'Main Course', 'Drinks', 'Desserts'] &&
             data.available is bool &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 1000));
    }

    function isValidOrderBase(data) {
      return data.keys().hasAll(['tableNumber', 'items', 'total', 'status', 'paymentStatus', 'createdAt', 'trackingToken']) &&
             // Table number — alphanumeric, dashes, spaces only
             data.tableNumber is string && data.tableNumber.size() > 0 && data.tableNumber.size() <= 20 &&
             data.tableNumber.matches('^[a-zA-Z0-9\\- ]{1,20}$') &&
             // Customer name — block HTML/script injection
             (!('customerName' in data) || (
               data.customerName is string && 
               data.customerName.size() <= 100 &&
               !data.customerName.matches('.*[<>].*')
             )) &&
             // Items validation
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             // Total — positive and within cap (₹10,00,000)
             data.total is number && data.total >= 0 && data.total <= 1000000 &&
             // Status enum whitelist
             data.status in ['pending', 'preparing', 'ready', 'served', 'cancelled'] &&
             // Payment status enum whitelist
             data.paymentStatus in ['paid', 'failed', 'pending_collection'] &&
             // Payment method enum whitelist
             (!('paymentMethod' in data) || data.paymentMethod in ['cash', 'upi']) &&
             // Timestamp validation
             data.createdAt is timestamp &&
             // Tracking token — random string for secure order tracking
             data.trackingToken is string && data.trackingToken.size() >= 16 && data.trackingToken.size() <= 64;
    }

    // Validates that paid (online) orders have valid Razorpay fields
    function isValidPaidOrder(data) {
      return data.paymentStatus == 'paid' &&
             data.paymentMethod == 'upi' &&
             // Razorpay order ID must match format: order_XXXX
             data.razorpayOrderId is string &&
             data.razorpayOrderId.size() >= 10 &&
             data.razorpayOrderId.matches('^order_[a-zA-Z0-9]+$') &&
             // Razorpay payment ID must match format: pay_XXXX
             data.razorpayPaymentId is string &&
             data.razorpayPaymentId.size() >= 10 &&
             data.razorpayPaymentId.matches('^pay_[a-zA-Z0-9]+$') &&
             // Verification token from Cloud Function (HMAC proof)
             data.verificationToken is string &&
             data.verificationToken.size() == 64;
    }

    // Validates that cash orders have correct fields
    function isValidCashOrder(data) {
      return data.paymentStatus == 'pending_collection' &&
             data.paymentMethod == 'cash' &&
             // Cash orders must NOT have Razorpay fields
             !('razorpayOrderId' in data) &&
             !('razorpayPaymentId' in data) &&
             !('verificationToken' in data);
    }

    // ─── Users Collection ────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        request.auth.token.email == userId ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isAdmin() && isValidUser(request.resource.data);
      allow update: if isAdmin() && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    // ─── Menu Collection ─────────────────────────────────────
    match /menu/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidMenuItem(request.resource.data);
      allow update: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // ─── Orders Collection ───────────────────────────────────
    match /orders/{orderId} {
      // Client-side order creation — validated by payment type
      allow create: if isValidOrderBase(request.resource.data)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    // Must be EITHER a valid paid order OR a valid cash order
                    && (isValidPaidOrder(request.resource.data) || isValidCashOrder(request.resource.data));
      
      // Anyone can GET a single order by ID (for tracking via URL)
      // Only staff/admin can LIST (query) all orders
      allow get: if true;
      allow list: if isStaff();
      allow update: if isStaff() && isValidOrderBase(request.resource.data);
      allow delete: if isAdmin();
    }

    // ─── Pending Orders Collection ───────────────────────────
    // Locked — no client should ever read or write
    match /pendingOrders/{orderId} {
      allow read, write: if false;
    }

    // ─── Feedback Collection ─────────────────────────────────
    match /feedback/{orderId} {
      allow create: if exists(/databases/$(database)/documents/orders/$(orderId))
                    && request.resource.data.keys().hasAll(['rating', 'createdAt'])
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.createdAt == request.time
                    // Optional comment — block HTML injection
                    && (!('comment' in request.resource.data) || (
                      request.resource.data.comment is string &&
                      request.resource.data.comment.size() <= 500 &&
                      !request.resource.data.comment.matches('.*[<>].*')
                    ));
      
      allow get: if true;
      allow list: if isStaff();
      // No update or delete — feedback is immutable
    }

    // ─── Reports Collection ──────────────────────────────────
    match /reports/{reportId} {
      allow read, write: if isStaff();
    }

    // ═══════════════════════════════════════════════════════════
    // CATCH-ALL: Deny everything not explicitly matched above
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
