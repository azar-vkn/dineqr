{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "A food or drink item on the menu.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the item" },
        "description": { "type": "string", "description": "Description of the item" },
        "price": { "type": "number", "description": "Price in INR or USD" },
        "category": { "type": "string", "enum": ["Starters", "Main Course", "Drinks", "Desserts"] },
        "image": { "type": "string", "format": "uri", "description": "Image URL" },
        "available": { "type": "boolean", "description": "Is the item currently available?" }
      },
      "required": ["name", "price", "category", "available"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order placed from a table.",
      "type": "object",
      "properties": {
        "tableNumber": { "type": "string", "description": "The table number where the order was placed" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" }
            },
            "required": ["id", "name", "price", "quantity"]
          }
        },
        "total": { "type": "number", "description": "Total order amount" },
        "status": { "type": "string", "enum": ["pending", "preparing", "ready", "served"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableNumber", "items", "total", "status", "paymentStatus", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user of the system with role-based access.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of users with their roles."
    },
    "menu": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Collection of all menu items."
    },
    "orders": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Collection of all customer orders."
    }
  }
}
