# Razorpay (public key only — secret goes in functions/.env)
VITE_RAZORPAY_KEY_ID=

# Admin email (bootstrap admin)
VITE_ADMIN_EMAIL=

# EmailJS credentials (get from https://emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase App Check — reCAPTCHA v3 Enterprise
# Get from: https://console.cloud.google.com/security/recaptcha
VITE_RECAPTCHA_SITE_KEY=

# Functions-only secrets (DO NOT prefix with VITE_)
# These go in functions/.env, NOT here:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
