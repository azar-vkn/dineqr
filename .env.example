# ============================================================
# DineQR — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# ─── Firebase Configuration ──────────────────────────────────
# Get from: Firebase Console → Project Settings → General → Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DB_ID=

# ─── Public menu URL (table QR codes) ───────────────────────
# The address customers reach when they scan a table QR. The desktop app
# runs from file://, so this must point at your deployed Firebase Hosting
# site (or custom domain). Leave blank for pure web builds to use the origin.
VITE_PUBLIC_APP_URL=

# ─── Google Sign-In, desktop build only ─────────────────────
# Google Cloud Console → Credentials → OAuth client ID → type "Desktop app".
# The web build uses signInWithPopup and ignores these.
# Also add this client ID under Firebase Console → Authentication → Google →
# Web SDK configuration → "Whitelist client IDs from external projects".
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# ─── Razorpay (public key only) ─────────────────────────────
# Secret key goes in functions/.env, NOT here
VITE_RAZORPAY_KEY_ID=

# ─── Admin email (bootstrap admin) ──────────────────────────
VITE_ADMIN_EMAIL=

# ─── EmailJS credentials ────────────────────────────────────
# Get from: https://emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ─── Firebase App Check — reCAPTCHA v3 Enterprise ───────────
# Get from: https://console.cloud.google.com/security/recaptcha
VITE_RECAPTCHA_SITE_KEY=

# ─── Functions-only secrets (DO NOT prefix with VITE_) ──────
# These go in functions/.env, NOT here:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
